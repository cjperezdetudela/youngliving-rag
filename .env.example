# Configuración de variables de entorno para Asesor Young Living RAG v0.4

# Introduce tu clave de API de Google Gemini (obtenida en Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_api_aqui

# Configuración opcional del modelo
GEMINI_MODEL=gemini-2.5-flash

# Configuración del servidor Flask
FLASK_PORT=5000
FLASK_DEBUG=True
